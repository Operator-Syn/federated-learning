# Python
.venv/
.venv-ci/
__pycache__/
*.pyc
*.egg-info/
build/
dist/

# tooling caches
.ruff_cache/
.pytest_cache/
.mypy_cache/
.hypothesis/
.cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Jupyter
.ipynb_checkpoints/
*.nbconvert.ipynb

# experiment output and model artifacts — run output belongs in runs/
runs/
*.csv
*.npy
*.npz
*.parquet
*.pkl
*.joblib
*.pt
*.pth
*.ckpt

# scratch files left by interrupted writes (scripts/refresh-references.py)
*.tmp

# local environment and secrets — never commit these
.env
.env.*
!.env.example

# editor and OS cruft
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*~

# obsidian vault config
.obsidian/

# Keep the complete source library versioned, except local editor settings and scratch files.
!docs/
!docs/**
docs/**/.obsidian/
docs/**/*.tmp
