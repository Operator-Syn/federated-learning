}


@misc{wangFederatedLearningFair2021,
	title = {Federated {Learning} with {Fair} {Averaging}},
	url = {http://arxiv.org/abs/2104.14937},
	doi = {10.48550/arXiv.2104.14937},
	abstract = {Fairness has emerged as a critical problem in federated learning (FL). In this work, we identify a cause of unfairness in FL – conﬂicting gradients with large differences in the magnitudes. To address this issue, we propose the federated fair averaging (FedFV) algorithm to mitigate potential conﬂicts among clients before averaging their gradients. We ﬁrst use the cosine similarity to detect gradient conﬂicts, and then iteratively eliminate such conﬂicts by modifying both the direction and the magnitude of the gradients. We further show the theoretical foundation of FedFV to mitigate the issue conﬂicting gradients and converge to Pareto stationary solutions. Extensive experiments on a suite of federated datasets conﬁrm that FedFV compares favorably against state-of-the-art methods in terms of fairness, accuracy and efﬁciency. The source code is available at https://github.com/WwZzz/easyFL.},
