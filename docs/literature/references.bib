@misc{choClientSelectionFederated2020,
	title = {Client {Selection} in {Federated} {Learning}: {Convergence} {Analysis} and {Power}-of-{Choice} {Selection} {Strategies}},
	shorttitle = {Client {Selection} in {Federated} {Learning}},
