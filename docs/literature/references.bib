	note = {arXiv:2203.10716 [cs.LG]},
	keywords = {Computer Science - Machine Learning, Statistics - Methodology},
	file = {PDF:/home/yashindo/Zotero/storage/JWLEK263/Hewamalage et al. - 2022 - Forecast Evaluation for Data Scientists Common Pitfalls and Best Practices.pdf:application/pdf},
