@misc{wangTacklingObjectiveInconsistency2020,
	title = {Tackling the {Objective} {Inconsistency} {Problem} in {Heterogeneous} {Federated} {Optimization}},
	url = {http://arxiv.org/abs/2007.07481},
	doi = {10.48550/arXiv.2007.07481},
	abstract = {In federated optimization, heterogeneity in the clients’ local datasets and computation speeds results in large variations in the number of local updates performed by each client in each communication round. Naive weighted aggregation of such models causes objective inconsistency, that is, the global model converges to a stationary point of a mismatched objective function which can be arbitrarily different from the true objective. This paper provides a general framework to analyze the convergence of federated heterogeneous optimization algorithms. It subsumes previously proposed methods such as FedAvg and FedProx and provides the ﬁrst principled understanding of the solution bias and the convergence slowdown due to objective inconsistency. Using insights from this analysis, we propose FedNova, a normalized averaging method that eliminates objective inconsistency while preserving fast error convergence.},
	language = {en},
	urldate = {2026-11-17},
	publisher = {arXiv},
	author = {Wang, Jianyu and Liu, Qinghua and Liang, Hao and Joshi, Gauri and Poor, H. Vincent},
